  k_2: Int32;
  pctArea: Double;
  lidUnit: PTLidUnit;
  lidList: PTLidList;
  lidGroup_2: PLidGroup;
begin
  j_2 := 0;
  k_2 := 0;
  pctArea := F0p0;
  lidUnit := nil;
  lidList := nil;
  lidGroup_2 := nil;
  c_fprintf(Frpt.file_, PAnsiChar(#10), []);
  c_fprintf(Frpt.file_, PAnsiChar(#10), []);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  *******************'), []);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  LID Control Summary'), []);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  *******************'), []);
  c_fprintf(Frpt.file_, PAnsiChar(#10'                                   No. of        Unit        Unit      %% Area    %% Imperv      %% Perv'), []);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  Subcatchment     LID Control      Units        Area       Width     Covered     Treated     Treated'), []);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  ---------------------------------------------------------------------------------------------------'), []);
  j_2 := 0;
  while (j_2 < GroupCount) do
  begin
    lidGroup_2 := LidGroups[j_2];
    if (lidGroup_2 = nil) then
    begin
      goto cont1;
    end;
    lidList := lidGroup_2^.lidList;
    while (lidList <> nil) do
    begin
      lidUnit := lidList^.lidUnit;
      k_2 := lidUnit^.lidIndex;
      pctArea := (((lidUnit^.area * I2FD(lidUnit^.number)) / Subcatch[j_2].area) * F100p0);
      c_fprintf(Frpt.file_, PAnsiChar(#10'  %-16s %-16s'), [PAnsiChar(Subcatch[j_2].ID), PAnsiChar(LidProcs[k_2].ID)]);
      c_fprintf(Frpt.file_, PAnsiChar('%6d  %10.2f  %10.2f  %10.2f  %10.2f  %10.2f'), [Int32(lidUnit^.number), (lidUnit^.area * ((UCF(3)) * (UCF(3)))), (lidUnit^.fullWidth * UCF(3)), pctArea, (lidUnit^.fromImperv * F100p0), (lidUnit^.fromPerv * F100p0)]);
      lidList := lidList^.nextLidUnit;
    end;
    cont1:
    Inc(j_2);
  end;
end;

