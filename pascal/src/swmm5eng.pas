function climate_readParams(tok_2: PPAnsiChar; ntoks: Int32): Int32;
label swend1;
var
  i: Int32;
  j_2: Int32;
  k_2: Int32;
  x: array[0..5] of Double;
  y_2: Double;
  aDate: Double;
  fname: array[0..259] of AnsiChar;
begin
  i := 0;
  j_2 := 0;
  k_2 := 0;
  FillChar(x, SizeOf(x), 0);
  y_2 := F0p0;
  aDate := F0p0;
  FillChar(fname, SizeOf(fname), 0);
  k_2 := findmatch(tok_2[0], @TempKeyWords[0]);
  if (k_2 < 0) then
  begin
    Exit(error_setInpError(205, tok_2[0]));
  end;
  case k_2 of
    0:
    begin
      if (ntoks < 2) then
      begin
        Exit(error_setInpError(203, PAnsiChar('')));
      end;
      i := project_findObject(8, tok_2[1]);
      if (i < 0) then
      begin
        Exit(error_setInpError(209, tok_2[1]));
      end;
      Temp.dataSource := 1;
      Temp.tSeries := i;
      Tseries[i].refersTo := 1;
      goto swend1;
    end;
    1:
    begin
      if (ntoks < 2) then
      begin
        Exit(error_setInpError(203, PAnsiChar('')));
      end;
      Temp.dataSource := 2;
      Fclimate.mode := #2;
      sstrncpy(@fname[0], tok_2[1], 259);
      sstrncpy(@Fclimate.name_[0], addAbsolutePath(@fname[0]), 259);
      Temp.fileStartDate := Fm693594p0;
      if (ntoks > 2) then
      begin
        if (Int32(ShortInt(tok_2[2]^)) <> 42) then
        begin
          if (not (datetime_strToDate(tok_2[2], @aDate) <> 0)) then
          begin
            Exit(error_setInpError(213, tok_2[2]));
          end;
          Temp.fileStartDate := aDate;
        end;
      end;
      FileTempUnits := 2;
      if (UnitSystem = 1) then
      begin
        FileTempUnits := 1;
      end;
      if (ntoks > 3) then
      begin
        i := findmatch(tok_2[3], @TempUnitsWords[0]);
        if (i < 0) then
        begin
          Exit(error_setInpError(205, tok_2[3]));
        end;
        FileTempUnits := i;
      end;
      goto swend1;
    end;
    2:
    begin
      if (strcomp(tok_2[1], PAnsiChar('FILE')) <> 0) then
      begin
        Wind.type_ := 1;
      end
      else
      begin
        if (ntoks < 14) then
        begin
          Exit(error_setInpError(203, PAnsiChar('')));
        end;
        Wind.type_ := 0;
        i := 0;
        while (i < 12) do
        begin
          if (not (getDouble(tok_2[Int32(i + 2)], @y_2) <> 0)) then
          begin
            Exit(error_setInpError(211, tok_2[Int32(i + 2)]));
          end;
          Wind.aws[i] := y_2;
          Inc(i);
        end;
      end;
      goto swend1;
    end;
    3:
    begin
      if (ntoks < 7) then
      begin
        Exit(error_setInpError(203, PAnsiChar('')));
      end;
      i := 1;
      while (i < 7) do
      begin
        if (not (getDouble(tok_2[i], @(x[Int32(i - 1)])) <> 0)) then
        begin
          Exit(error_setInpError(211, tok_2[i]));
        end;
        Inc(i);
      end;
      if (UnitSystem = 1) then
      begin
        x[0] := (((F9p0 / F5p0) * x[0]) + F32p0);
      end;
      Snow.snotmp := x[0];
      Snow.tipm := x[1];
      Snow.rnm := x[2];
      Temp.elev := (x[3] / UCF(3));
      Temp.anglat := x[4];
      Temp.dtlong := (x[5] / F60p0);
      goto swend1;
    end;
    4:
    begin
      if (ntoks < 12) then
      begin
        Exit(error_setInpError(203, PAnsiChar('')));
      end;
      if (match(tok_2[1], PAnsiChar('IMPERV')) <> 0) then
      begin
        i := 0;
      end
      else if (match(tok_2[1], PAnsiChar('PERV')) <> 0) then
      begin
        i := 1;
      end
      else
      begin
        Exit(error_setInpError(205, tok_2[1]));
      end;
      j_2 := 0;
      while (j_2 < 10) do
      begin
        if (((not (getDouble(tok_2[Int32(j_2 + 2)], @y_2) <> 0)) or (y_2 < F0p0)) or (y_2 > F1p0)) then
        begin
          Exit(error_setInpError(211, tok_2[Int32(j_2 + 2)]));
        end;
        Snow.adc[i][j_2] := y_2;
        Inc(j_2);
      end;
      goto swend1;
    end;
  end;
  swend1: ;
  Exit(0);
end;

