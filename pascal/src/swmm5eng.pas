  j_2 := 0;
  k_2 := 0;
  p := 0;
  x := F0p0;
  outfallCount := F0p0;
  flowCount := F0p0;
  flowSum := F0p0;
  freqSum := F0p0;
  volSum := F0p0;
  totals := nil;
  if (Nnodes[1] > 0) then
  begin
    totals := PDouble(c_calloc(UInt64(Int64(Nobjects[4])), 8));
    p := 0;
    while (p < Nobjects[4]) do
    begin
      totals[p] := F0p0;
      Inc(p);
    end;
    flowSum := F0p0;
    freqSum := F0p0;
    volSum := F0p0;
    report_writeLine(PAnsiChar(''));
    report_writeLine(PAnsiChar('***********************'));
    report_writeLine(PAnsiChar('Outfall Loading Summary'));
    report_writeLine(PAnsiChar('***********************'));
    report_writeLine(PAnsiChar(''));
    c_fprintf(Frpt.file_, PAnsiChar(#10'  -----------------------------------------------------------'), []);
    p := 0;
    while (p < Nobjects[4]) do
    begin
      c_fprintf(Frpt.file_, PAnsiChar('--------------'), []);
      Inc(p);
    end;
    c_fprintf(Frpt.file_, PAnsiChar(#10'                         Flow       Avg       Max       Total'), []);
    p := 0;
    while (p < Nobjects[4]) do
    begin
      c_fprintf(Frpt.file_, PAnsiChar('         Total'), []);
      Inc(p);
    end;
    c_fprintf(Frpt.file_, PAnsiChar(#10'                         Freq      Flow      Flow      Volume'), []);
    p := 0;
    while (p < Nobjects[4]) do
    begin
      c_fprintf(Frpt.file_, PAnsiChar('%14s'), [PAnsiChar(Pollut[p].ID)]);
      Inc(p);
    end;
    c_fprintf(Frpt.file_, PAnsiChar(#10'  Outfall Node           Pcnt       %3s       %3s    %8s'), [PAnsiChar(FlowUnitWords[FlowUnits]), PAnsiChar(FlowUnitWords[FlowUnits]), PAnsiChar(VolUnitsWords[UnitSystem])]);
    p := 0;
    while (p < Nobjects[4]) do
    begin
      i := UnitSystem;
      if (Pollut[p].units = 2) then
      begin
        i := 2;
      end;
      sstrncpy(@units[0], LoadUnitsWords[i], 14);
      c_fprintf(Frpt.file_, PAnsiChar('%14s'), [PAnsiChar(@units[0])]);
      Inc(p);
    end;
    c_fprintf(Frpt.file_, PAnsiChar(#10'  -----------------------------------------------------------'), []);
    p := 0;
    while (p < Nobjects[4]) do
    begin
      c_fprintf(Frpt.file_, PAnsiChar('--------------'), []);
      Inc(p);
    end;
    j_2 := 0;
    while (j_2 < Nobjects[2]) do
    begin
      if (Node[j_2].type_ <> 1) then
      begin
        goto cont1;
      end;
      k_2 := Node[j_2].subIndex;
      flowCount := I2FD(OutfallStats[k_2].totalPeriods);
      c_fprintf(Frpt.file_, PAnsiChar(#10'  %-20s'), [PAnsiChar(Node[j_2].ID)]);
      x := ((F100p0 * flowCount) / I2FD(ReportStepCount));
      c_fprintf(Frpt.file_, PAnsiChar('%7.2f'), [x]);
      freqSum := (freqSum + x);
      if (flowCount > F0p0) then
      begin
        x := ((OutfallStats[k_2].avgFlow * UCF(10)) / flowCount);
      end
      else
      begin
        x := F0p0;
      end;
      flowSum := (flowSum + x);
      c_fprintf(Frpt.file_, PAnsiChar(' '), []);
      c_fprintf(Frpt.file_, @FlowFmt[0], [x]);
      c_fprintf(Frpt.file_, PAnsiChar(' '), []);
      c_fprintf(Frpt.file_, @FlowFmt[0], [(OutfallStats[k_2].maxFlow * UCF(10))]);
      c_fprintf(Frpt.file_, PAnsiChar('%12.3f'), [(NodeInflow[j_2] * Vcf)]);
      volSum := (volSum + NodeInflow[j_2]);
      p := 0;
      while (p < Nobjects[4]) do
      begin
        x := ((OutfallStats[k_2].totalLoad[p] * F28p317) * Pollut[p].mcf);
        totals[p] := (totals[p] + x);
        if (Pollut[p].units = 2) then
        begin
          if (x > F0p0) then
          begin
            x := c_log10(x);
          end
          else
          begin
            x := x;
          end;
        end;
        c_fprintf(Frpt.file_, PAnsiChar('%14.3f'), [x]);
        Inc(p);
      end;
      cont1:
      Inc(j_2);
    end;
    outfallCount := I2FD(Nnodes[1]);
    c_fprintf(Frpt.file_, PAnsiChar(#10'  -----------------------------------------------------------'), []);
    p := 0;
    while (p < Nobjects[4]) do
    begin
      c_fprintf(Frpt.file_, PAnsiChar('--------------'), []);
      Inc(p);
    end;
    c_fprintf(Frpt.file_, PAnsiChar(#10'  System              %7.2f '), [(freqSum / outfallCount)]);
    c_fprintf(Frpt.file_, @FlowFmt[0], [flowSum]);
