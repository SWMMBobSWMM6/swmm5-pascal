function routing_getRoutingStep(routingModel: Int32; fixedStep: Double): Double;
var
  date1: Double;
  date2: Double;
  nextTime: Double;
  routingStep: Double;
  nextRuleTime: Double;
  nextRoutingTime: Double;
begin
  date1 := F0p0;
  date2 := F0p0;
  nextTime := F0p0;
  routingStep := F0p0;
  nextRuleTime := F0p0;
  nextRoutingTime := F0p0;
  routingStep := F0p0;
  if (Nobjects[3] = 0) then
  begin
    Exit(fixedStep);
  end;
  if ((NumEvents > 0) and (BetweenEvents <> 0)) then
  begin
    if (NewRunoffTime <= ReportTime) then
    begin
      nextTime := NewRunoffTime;
    end
    else
    begin
      nextTime := ReportTime;
    end;
    date1 := getDateTime(NewRoutingTime);
    date2 := getDateTime(nextTime);
    if ((date2 > date1) and (date2 < Event[NextEvent].start)) then
    begin
      routingStep := ((nextTime - NewRoutingTime) / F1000p0);
    end
    else
    begin
      date1 := getDateTime((NewRoutingTime + (F1000p0 * fixedStep)));
      if (date1 < Event[NextEvent].start) then
      begin
        Exit(fixedStep);
      end;
    end;
  end;
  if (routingStep = F0p0) then
  begin
    routingStep := flowrout_getRoutingStep(routingModel, fixedStep);
  end;
  if (RuleStep > 0) then
  begin
    nextRuleTime := (NewRuleTime + (F1000p0 * I2FD(RuleStep)));
    nextRoutingTime := (NewRoutingTime + (F1000p0 * routingStep));
    if (nextRoutingTime >= nextRuleTime) then
    begin
      routingStep := ((nextRuleTime - NewRoutingTime) / F1000p0);
    end;
  end;
  Exit(routingStep);
end;

{ routing.c:203 }
procedure routing_execute(routingModel: Int32; routingStep: Double);
var
  trialsCount: Int32;
  actionCount: Int32;
  inSteadyState: Int32;
  currentDate_2: Double;
  stepFlowError: Double;
begin
  trialsCount := 0;
  actionCount := 0;
  inSteadyState := 0;
  currentDate_2 := F0p0;
  stepFlowError := F0p0;
  trialsCount := 1;
  actionCount := 0;
  inSteadyState := 1;
  if (ErrorCode <> 0) then
  begin
    Exit;
  end;
  massbal_updateRoutingTotals((routingStep / F2p0));
  currentDate_2 := getDateTime(NewRoutingTime);
  actionCount := evaluateControlRules(currentDate_2, routingStep);
  stepFlowError := massbal_getStepFlowError();
  massbal_initTimeStepTotals();
  initSystemInflows();
  BetweenEvents := isBetweenEvents(currentDate_2);
  if (BetweenEvents = 0) then
  begin
    addSystemInflows(currentDate_2, routingStep);
    inlet_findCapturedFlows(routingStep);
    inSteadyState := isInSteadyState(actionCount, stepFlowError);
    if (inSteadyState = 0) then
    begin
      trialsCount := routeFlow(routingModel, routingStep);
    end;
    if ((Nobjects[4] > 0) and (not (IgnoreQuality <> 0))) then
    begin
      inlet_adjustQualInflows();
      qualrout_execute(routingStep);
    end;
    removeSystemOutflows(routingStep);
    inlet_adjustQualOutflows();
    if (Nobjects[3] > 0) then
    begin
      stats_updateFlowStats(routingStep, getDateTime(NewRoutingTime));
      stats_updateTimeStepStats(routingStep, trialsCount, inSteadyState);
    end;
  end;
  massbal_updateRoutingTotals((routingStep / F2p0));
end;

{ routing.c:269 }
function evaluateControlRules(currentDate_2: Double; routingStep: Double): Int32;
var
  j_2: Int32;
  actionCount: Int32;
begin
  j_2 := 0;
  actionCount := 0;
  actionCount := 0;
  j_2 := 0;
  while (j_2 < Nobjects[3]) do
  begin
    link_setTargetSetting(j_2);
    Inc(j_2);
  end;
  if ((RuleStep = 0) or (c_fabs((NewRoutingTime - NewRuleTime)) < F1p0)) then
  begin
    controls_evaluate(currentDate_2, (currentDate_2 - StartDateTime), (routingStep / F86400p0));
  end;
  j_2 := 0;
  while (j_2 < Nobjects[3]) do
  begin
    if (Link[j_2].targetSetting <> Link[j_2].setting) then
    begin
      if ((Link[j_2].targetSetting * Link[j_2].setting) = F0p0) then
      begin
        Link[j_2].timeLastSet := currentDate_2;
      end;
      link_setSetting(j_2, routingStep);
      Inc(actionCount);
    end;
    Inc(j_2);
  end;
  OldRoutingTime := NewRoutingTime;
  NewRoutingTime := (NewRoutingTime + (F1000p0 * routingStep));
  if (c_fabs((NewRoutingTime - (NewRuleTime + (F1000p0 * I2FD(RuleStep))))) < F1p0) then
  begin
    NewRuleTime := (NewRuleTime + (F1000p0 * I2FD(RuleStep)));
  end;
  Exit(actionCount);
end;

