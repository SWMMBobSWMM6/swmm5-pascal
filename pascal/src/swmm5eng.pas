{ report.c:93 }
function report_readOptions(tok_2: PPAnsiChar; ntoks: Int32): Int32;
label swend2, swend3, swend4;
var
  k_2: AnsiChar;
  j_2: Int32;
  m_2: Int32;
  t_2: Int32;
begin
  k_2 := #0;
  j_2 := 0;
  m_2 := 0;
  t_2 := 0;
  if (ntoks < 2) then
  begin
    Exit(error_setInpError(203, PAnsiChar('')));
  end;
  k_2 := AnsiChar(findmatch(tok_2[0], @ReportWords[0]));
  if (Int32(ShortInt(k_2)) < 0) then
  begin
    Exit(error_setInpError(205, tok_2[0]));
  end;
  if ((Int32(ShortInt(k_2)) < 2) or (Int32(ShortInt(k_2)) > 4)) then
  begin
    m_2 := findmatch(tok_2[1], @NoYesWords[0]);
    if ((m_2 < 0) or (m_2 > 1)) then
    begin
      Exit(error_setInpError(205, tok_2[1]));
    end;
    case Int32(ShortInt(k_2)) of
      0:
      begin
        RptFlags.disabled := AnsiChar(m_2);
        Exit(0);
      end;
      1:
      begin
        RptFlags.input := AnsiChar(m_2);
        Exit(0);
      end;
      5:
      begin
        RptFlags.continuity := AnsiChar(m_2);
        Exit(0);
      end;
      6:
      begin
        RptFlags.flowStats := AnsiChar(m_2);
        Exit(0);
      end;
      7:
      begin
        RptFlags.controls := AnsiChar(m_2);
        Exit(0);
      end;
      8:
      begin
        RptFlags.averages := AnsiChar(m_2);
        Exit(0);
      end;
      9:
      begin
        Exit(0);
      end;
      else
      begin
        Exit(error_setInpError(205, tok_2[1]));
      end;
    end;
  end
  else
  begin
    case Int32(ShortInt(k_2)) of
      2:
      begin
        m_2 := 1;
        goto swend2;
      end;
      3:
      begin
        m_2 := 2;
        goto swend2;
      end;
      4:
      begin
        m_2 := 3;
        goto swend2;
      end;
    end;
    swend2: ;
  end;
  if (strcomp(tok_2[1], PAnsiChar('NONE')) <> 0) then
  begin
    k_2 := #0;
  end
  else if (strcomp(tok_2[1], PAnsiChar('ALL')) <> 0) then
  begin
    k_2 := #1;
  end
  else
  begin
    k_2 := #2;
    t_2 := 1;
    while (t_2 < ntoks) do
    begin
      j_2 := project_findObject(m_2, tok_2[t_2]);
      if (j_2 < 0) then
      begin
        Exit(error_setInpError(209, tok_2[t_2]));
      end;
      case m_2 of
        SUBCATCH_:
        begin
          Subcatch[j_2].rptFlag := 1;
          goto swend3;
        end;
        NODE_:
        begin
          Node[j_2].rptFlag := 1;
          goto swend3;
        end;
        LINK_:
        begin
          Link[j_2].rptFlag := 1;
          goto swend3;
        end;
      end;
      swend3: ;
      Inc(t_2);
    end;
  end;
  case m_2 of
    SUBCATCH_:
    begin
      RptFlags.subcatchments := k_2;
      goto swend4;
    end;
    NODE_:
    begin
      RptFlags.nodes := k_2;
      goto swend4;
    end;
    LINK_:
    begin
      RptFlags.links := k_2;
      goto swend4;
    end;
  end;
  swend4: ;
  Exit(0);
end;

