{ roadway.c:146 }
function getCd(hWr: Double; ht: Double; roadWidth: Double; roadSurf: Int32): Double;
var
  kT: Double;
  hL: Double;
  htH: Double;
  cR: Double;
begin
  kT := F0p0;
  hL := F0p0;
  htH := F0p0;
  cR := F0p0;
  kT := F1p0;
  if (hWr <= F0p0) then
  begin
    Exit(F0p0);
  end;
  hL := (hWr / roadWidth);
  if (hL <= F0p15) then
  begin
    if (roadSurf = 1) then
    begin
      cR := getY(hWr, PA2_Double(@Cr_Low_Paved[0]), N_Cr_Low_Paved);
    end
    else
    begin
      cR := getY(hWr, PA2_Double(@Cr_Low_Gravel[0]), N_Cr_Low_Gravel);
    end;
  end
  else
  begin
    if (roadSurf = 1) then
    begin
      cR := getY(hL, PA2_Double(@Cr_High_Paved[0]), N_Cr_High_Paved);
    end
    else
    begin
      cR := getY(hL, PA2_Double(@Cr_High_Gravel[0]), N_Cr_High_Gravel);
    end;
  end;
  if (ht > F0p0) then
  begin
    htH := (ht / hWr);
    if (roadSurf = 1) then
    begin
      kT := getY(htH, PA2_Double(@Kt_Paved[0]), N_Kt_Paved);
    end
    else
    begin
      kT := getY(htH, PA2_Double(@Kt_Gravel[0]), N_Kt_Gravel);
    end;
  end;
  Exit((cR * kT));
end;

{ roadway.c:176 }
function getY(x: Double; table: PA2_Double; n_2: Int32): Double;
var
  i: Int32;
  x1: Double;
  y1: Double;
  dx: Double;
  dy: Double;
begin
  i := 0;
  x1 := F0p0;
  y1 := F0p0;
  dx := F0p0;
  dy := F0p0;
  if (x <= table[0][0]) then
  begin
    Exit(table[0][1]);
  end;
  if (x >= (table[Int32(n_2 - 1)])[0]) then
  begin
    Exit((table[Int32(n_2 - 1)])[1]);
  end;
  i := 1;
  while (i < n_2) do
  begin
    if (x <= table[i][0]) then
    begin
      x1 := (table[Int32(i - 1)])[0];
      dx := (table[i][0] - x1);
      y1 := (table[Int32(i - 1)])[1];
      dy := (table[i][1] - y1);
      Exit((y1 + (((x - x1) * dy) / dx)));
    end;
    Inc(i);
  end;
  Exit((table[Int32(n_2 - 1)])[1]);
end;

