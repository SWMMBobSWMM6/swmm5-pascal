{ stats.c:647 }
procedure stats_updateLinkStats(j_2: Int32; tStep: Double; aDate: Double);
label swend1;
var
  k_2: Int32;
  q_2: Double;
  v_2: Double;
  dq: Double;
begin
  k_2 := 0;
  q_2 := F0p0;
  v_2 := F0p0;
  dq := F0p0;
  dq := (Link[j_2].newFlow - Link[j_2].oldFlow);
  q_2 := c_fabs(Link[j_2].newFlow);
  if (q_2 > LinkStats[j_2].maxFlow) then
  begin
    LinkStats[j_2].maxFlow := q_2;
    LinkStats[j_2].maxFlowDate := aDate;
  end;
  v_2 := link_getVelocity(j_2, q_2, Link[j_2].newDepth);
  if (v_2 > LinkStats[j_2].maxVeloc) then
  begin
    LinkStats[j_2].maxVeloc := v_2;
  end;
  if (Link[j_2].newDepth > LinkStats[j_2].maxDepth) then
  begin
    LinkStats[j_2].maxDepth := Link[j_2].newDepth;
  end;
  if (Link[j_2].type_ = 1) then
  begin
    if (q_2 >= Link[j_2].qFull) then
    begin
      LinkStats[j_2].timeFullFlow := (LinkStats[j_2].timeFullFlow + tStep);
    end;
    if (q_2 > F0p001) then
    begin
      k_2 := Link[j_2].subIndex;
      if (PumpStats[k_2].minFlow <= q_2) then
      begin
        PumpStats[k_2].minFlow := PumpStats[k_2].minFlow;
      end
      else
      begin
        PumpStats[k_2].minFlow := q_2;
      end;
      PumpStats[k_2].maxFlow := LinkStats[j_2].maxFlow;
      PumpStats[k_2].avgFlow := (PumpStats[k_2].avgFlow + q_2);
      PumpStats[k_2].volume := (PumpStats[k_2].volume + (q_2 * tStep));
      PumpStats[k_2].utilized := (PumpStats[k_2].utilized + tStep);
      PumpStats[k_2].energy := (PumpStats[k_2].energy + ((link_getPower(j_2) * tStep) / F3600p0));
      if (Link[j_2].flowClass = 2) then
      begin
        PumpStats[k_2].offCurveLow := (PumpStats[k_2].offCurveLow + tStep);
      end;
      if (Link[j_2].flowClass = 1) then
      begin
        PumpStats[k_2].offCurveHigh := (PumpStats[k_2].offCurveHigh + tStep);
      end;
      if (Link[j_2].oldFlow < F0p001) then
      begin
        Inc(PumpStats[k_2].startUps);
      end;
      Inc(PumpStats[k_2].totalPeriods);
      LinkStats[j_2].timeSurcharged := (LinkStats[j_2].timeSurcharged + tStep);
      LinkStats[j_2].timeFullUpstream := (LinkStats[j_2].timeFullUpstream + tStep);
      LinkStats[j_2].timeFullDnstream := (LinkStats[j_2].timeFullDnstream + tStep);
    end;
  end
  else if (Link[j_2].type_ = 0) then
  begin
    if (Link[j_2].normalFlow <> #0) then
    begin
      LinkStats[j_2].timeNormalFlow := (LinkStats[j_2].timeNormalFlow + tStep);
    end;
    if (Link[j_2].inletControl <> #0) then
    begin
      LinkStats[j_2].timeInletControl := (LinkStats[j_2].timeInletControl + tStep);
    end;
    k_2 := Link[j_2].flowClass;
    if ((k_2 >= 0) and (k_2 < 7)) then
    begin
      LinkStats[j_2].timeInFlowClass[k_2] := (LinkStats[j_2].timeInFlowClass[k_2] + tStep);
    end;
    k_2 := Link[j_2].subIndex;
    if (q_2 >= (Link[j_2].qFull * I2FD(ShortInt(Conduit[k_2].barrels)))) then
    begin
      LinkStats[j_2].timeFullFlow := (LinkStats[j_2].timeFullFlow + tStep);
    end;
    if (Conduit[k_2].capacityLimited <> #0) then
    begin
      LinkStats[j_2].timeCapacityLimited := (LinkStats[j_2].timeCapacityLimited + tStep);
    end;
    case Int32(ShortInt(Conduit[k_2].fullState)) of
      ALL_FULL:
      begin
        LinkStats[j_2].timeSurcharged := (LinkStats[j_2].timeSurcharged + tStep);
        LinkStats[j_2].timeFullUpstream := (LinkStats[j_2].timeFullUpstream + tStep);
        LinkStats[j_2].timeFullDnstream := (LinkStats[j_2].timeFullDnstream + tStep);
        goto swend1;
      end;
      UP_FULL:
      begin
        LinkStats[j_2].timeFullUpstream := (LinkStats[j_2].timeFullUpstream + tStep);
        goto swend1;
      end;
      DN_FULL:
      begin
        LinkStats[j_2].timeFullDnstream := (LinkStats[j_2].timeFullDnstream + tStep);
      end;
    end;
    swend1: ;
    if (Link[j_2].xsect.type_ = 25) then
    begin
      if (LinkStats[j_2].maxStreetFilled >= (street_getExtentFilled(j_2))) then
      begin
        LinkStats[j_2].maxStreetFilled := LinkStats[j_2].maxStreetFilled;
      end
      else
      begin
        LinkStats[j_2].maxStreetFilled := (street_getExtentFilled(j_2));
      end;
    end;
  end;
  k_2 := LinkStats[j_2].flowTurnSign;
  if (dq < F0p0) then
  begin
    LinkStats[j_2].flowTurnSign := (-1);
  end
  else
  begin
    LinkStats[j_2].flowTurnSign := 1;
  end;
  if ((c_fabs(dq) > F0p001) and (Int32(k_2 * LinkStats[j_2].flowTurnSign) < 0)) then
  begin
    Inc(LinkStats[j_2].flowTurns);
  end;
end;

{ stats.c:756 }
procedure stats_findMaxStats();
label cont1;
var
  j_2: Int32;
  x: Double;
  z: Double;
  stepCount: Double;
begin
  j_2 := 0;
  x := F0p0;
  z := F0p0;
  stepCount := F0p0;
  j_2 := 0;
  while (j_2 < 5) do
  begin
    MaxMassBalErrs[j_2].objType := 2;
    MaxMassBalErrs[j_2].index_ := (-1);
    MaxMassBalErrs[j_2].value := (-F1p0);
    MaxCourantCrit[j_2].index_ := (-1);
    MaxCourantCrit[j_2].value := (-F1p0);
    MaxFlowTurns[j_2].index_ := (-1);
    MaxFlowTurns[j_2].value := (-F1p0);
    MaxNonConverged[j_2].index_ := (-1);
    MaxNonConverged[j_2].value := F0p0;
    Inc(j_2);
  end;
  if (ReportStepCount > 2) then
  begin
    stepCount := I2FD(ReportStepCount);
    z := (F100p0 / ((F2p0 / F3p0) * (stepCount - F2p0)));
    j_2 := 0;
    while (j_2 < Nobjects[3]) do
    begin
      x := (I2FD(LinkStats[j_2].flowTurns) * z);
      stats_updateMaxStats(@MaxFlowTurns[0], 3, j_2, x);
      Inc(j_2);
    end;
  end;
  j_2 := 0;
  while (j_2 < Nobjects[2]) do
  begin
    if (Node[j_2].degree <= 0) then
    begin
      goto cont1;
    end;
    if (NodeInflow[j_2] <= F0p1) then
    begin
      goto cont1;
    end;
    if (NodeInflow[j_2] > F0p0) then
    begin
      x := (F1p0 - (NodeOutflow[j_2] / NodeInflow[j_2]));
    end
    else if (NodeOutflow[j_2] > F0p0) then
    begin
      x := (-F1p0);
    end
    else
    begin
      x := F0p0;
    end;
    stats_updateMaxStats(@MaxMassBalErrs[0], 2, j_2, (F100p0 * x));
    cont1:
    Inc(j_2);
  end;
  stepCount := I2FD(TimeStepStats.timeStepCount);
  if (RouteModel = 4) then
  begin
    j_2 := 0;
    while (j_2 < Nobjects[2]) do
    begin
      stats_updateMaxStats(@MaxNonConverged[0], 2, j_2, (I2FD(NodeStats[j_2].nonConvergedCount) / stepCount));
      Inc(j_2);
    end;
  end;
  if ((RouteModel <> 4) or (CourantFactor = F0p0)) then
  begin
    Exit;
  end;
  if (stepCount = F0p0) then
  begin
    Exit;
  end;
  j_2 := 0;
  while (j_2 < Nobjects[2]) do
  begin
    x := (NodeStats[j_2].timeCourantCritical / stepCount);
    stats_updateMaxStats(@MaxCourantCrit[0], 2, j_2, (F100p0 * x));
    Inc(j_2);
  end;
  j_2 := 0;
  while (j_2 < Nobjects[3]) do
  begin
    x := (LinkStats[j_2].timeCourantCritical / stepCount);
    stats_updateMaxStats(@MaxCourantCrit[0], 3, j_2, (F100p0 * x));
    Inc(j_2);
  end;
end;

