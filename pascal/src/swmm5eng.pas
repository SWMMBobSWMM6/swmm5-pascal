{ statsrpt.c:403 }
procedure writeNodeSurcharge();
label cont1;
var
  j_2: Int32;
  n_2: Int32;
  t_2: Double;
  d1: Double;
  d2: Double;
begin
  j_2 := 0;
  n_2 := 0;
  t_2 := F0p0;
  d1 := F0p0;
  d2 := F0p0;
  n_2 := 0;
  report_writeLine(PAnsiChar(''));
  report_writeLine(PAnsiChar('**********************'));
  report_writeLine(PAnsiChar('Node Surcharge Summary'));
  report_writeLine(PAnsiChar('**********************'));
  report_writeLine(PAnsiChar(''));
  j_2 := 0;
  while (j_2 < Nobjects[2]) do
  begin
    if (Node[j_2].type_ = 1) then
    begin
      goto cont1;
    end;
    if (NodeStats[j_2].timeSurcharged = F0p0) then
    begin
      goto cont1;
    end;
    if (F0p01 >= (NodeStats[j_2].timeSurcharged / F3600p0)) then
    begin
      t_2 := F0p01;
    end
    else
    begin
      t_2 := (NodeStats[j_2].timeSurcharged / F3600p0);
    end;
    if (n_2 = 0) then
    begin
      report_writeLine(PAnsiChar('Surcharging occurs when water rises above the top of the highest conduit.'));
      c_fprintf(Frpt.file_, PAnsiChar(#10'  ---------------------------------------------------------------------'#10'                                               Max. Height   Min. Depth'#10'                                   Hours       Above Crown    Below Rim'), []);
      if (UnitSystem = 0) then
      begin
        c_fprintf(Frpt.file_, PAnsiChar(#10'  Node                 Type      Surcharged           Feet         Feet'), []);
      end
      else
      begin
        c_fprintf(Frpt.file_, PAnsiChar(#10'  Node                 Type      Surcharged         Meters       Meters'), []);
      end;
      c_fprintf(Frpt.file_, PAnsiChar(#10'  ---------------------------------------------------------------------'), []);
      n_2 := 1;
    end;
    c_fprintf(Frpt.file_, PAnsiChar(#10'  %-20s'), [PAnsiChar(Node[j_2].ID)]);
    c_fprintf(Frpt.file_, PAnsiChar(' %-9s'), [PAnsiChar(NodeTypeWords[Node[j_2].type_])]);
    d1 := ((NodeStats[j_2].maxDepth + Node[j_2].invertElev) - Node[j_2].crownElev);
    if (d1 < F0p0) then
    begin
      d1 := F0p0;
    end;
    d2 := (Node[j_2].fullDepth - NodeStats[j_2].maxDepth);
    if (d2 < F0p0) then
    begin
      d2 := F0p0;
    end;
    c_fprintf(Frpt.file_, PAnsiChar('  %9.2f      %9.3f    %9.3f'), [t_2, (d1 * UCF(3)), (d2 * UCF(3))]);
    cont1:
    Inc(j_2);
  end;
  if (n_2 = 0) then
  begin
    report_writeLine(PAnsiChar('No nodes were surcharged.'));
  end;
  report_writeLine(PAnsiChar(''));
end;

