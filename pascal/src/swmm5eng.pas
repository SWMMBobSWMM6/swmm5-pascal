{ report.c:923 }
procedure report_writeMaxStats(maxMassBalErrs_2: PTMaxStats; maxCourantCrit_2: PTMaxStats; nMaxStats: Int32);
label cont1, cont2;
var
  i: Int32;
  j_2: Int32;
  k_2: Int32;
begin
  i := 0;
  j_2 := 0;
  k_2 := 0;
  if ((RouteModel <> 4) or (Nobjects[3] = 0)) then
  begin
    Exit;
  end;
  if (nMaxStats <= 0) then
  begin
    Exit;
  end;
  if (maxMassBalErrs_2[0].index_ >= 0) then
  begin
    report_writeLine(PAnsiChar(''));
    report_writeLine(PAnsiChar('*************************'));
    report_writeLine(PAnsiChar('Highest Continuity Errors'));
    report_writeLine(PAnsiChar('*************************'));
    i := 0;
    while (i < nMaxStats) do
    begin
      j_2 := maxMassBalErrs_2[i].index_;
      if (j_2 < 0) then
      begin
        goto cont1;
      end;
      c_fprintf(Frpt.file_, PAnsiChar(#10'  Node %s (%.2f%%)'), [PAnsiChar(Node[j_2].ID), maxMassBalErrs_2[i].value]);
      cont1:
      Inc(i);
    end;
    report_writeLine(PAnsiChar(''));
  end;
  if (CourantFactor = F0p0) then
  begin
    Exit;
  end;
  report_writeLine(PAnsiChar(''));
  report_writeLine(PAnsiChar('***************************'));
  report_writeLine(PAnsiChar('Time-Step Critical Elements'));
  report_writeLine(PAnsiChar('***************************'));
  k_2 := 0;
  i := 0;
  while (i < nMaxStats) do
  begin
    j_2 := maxCourantCrit_2[i].index_;
    if (j_2 < 0) then
    begin
      goto cont2;
    end;
    Inc(k_2);
    if (maxCourantCrit_2[i].objType = 2) then
    begin
      c_fprintf(Frpt.file_, PAnsiChar(#10'  Node %s'), [PAnsiChar(Node[j_2].ID)]);
    end
    else
    begin
      c_fprintf(Frpt.file_, PAnsiChar(#10'  Link %s'), [PAnsiChar(Link[j_2].ID)]);
    end;
    c_fprintf(Frpt.file_, PAnsiChar(' (%.2f%%)'), [maxCourantCrit_2[i].value]);
    cont2:
    Inc(i);
  end;
  if (k_2 = 0) then
  begin
    c_fprintf(Frpt.file_, PAnsiChar(#10'  None'), []);
  end;
  report_writeLine(PAnsiChar(''));
end;

