{ kinwave.c:170 }
function solveContinuity(qin: Double; ain: Double; aout: PDouble): Int32;
var
  n_2: Int32;
  aLo: Double;
  aHi: Double;
  aTmp: Double;
  fLo: Double;
  fHi: Double;
  tol: Double;
begin
  n_2 := 0;
  aLo := F0p0;
  aHi := F0p0;
  aTmp := F0p0;
  fLo := F0p0;
  fHi := F0p0;
  tol := F0p0;
  tol := EPSIL;
  aHi := F1p0;
  fHi := ((F1p0 + C1) + C2);
  aLo := (xsect_getAmax(pXsect) / Afull);
  if (aLo < aHi) then
  begin
    fLo := (((Beta1 * pXsect^.sMax) + (C1 * aLo)) + C2);
  end
  else
  begin
    fLo := fHi;
  end;
  if ((fHi * fLo) > F0p0) then
  begin
    aHi := aLo;
    fHi := fLo;
    aLo := F0p0;
    fLo := C2;
  end;
  if ((fHi * fLo) <= F0p0) then
  begin
    if ((aout^ < aLo) or (aout^ > aHi)) then
    begin
      aout^ := (F0p5 * (aLo + aHi));
    end;
    if (fLo > fHi) then
    begin
      aTmp := aLo;
      aLo := aHi;
      aHi := aTmp;
    end;
    n_2 := findroot_Newton(aLo, aHi, aout, tol, @evalContinuity, nil);
    if (n_2 <= 0) then
    begin
      n_2 := (-1);
    end;
  end
  else if (fLo < F0p0) then
  begin
    if (qin > F1p0) then
    begin
      aout^ := ain;
    end
    else
    begin
      aout^ := F1p0;
    end;
    n_2 := (-2);
  end
  else if (fLo > F0p0) then
  begin
    aout^ := F0p0;
    n_2 := (-3);
  end
  else
  begin
    n_2 := (-1);
  end;
  Exit(n_2);
end;

