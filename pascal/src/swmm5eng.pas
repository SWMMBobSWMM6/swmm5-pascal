{ report.c:1037 }
procedure report_writeTimeStepStats(timeStepStats_2: PTTimeStepStats);
var
  timeStepCount: Double;
  totalRoutingTime: Double;
  fSteadyState: Double;
begin
  timeStepCount := F0p0;
  totalRoutingTime := F0p0;
  fSteadyState := F0p0;
  timeStepCount := I2FD(timeStepStats_2^.timeStepCount);
  fSteadyState := F0p0;
  if ((Nobjects[3] = 0) or (I2FD(timeStepStats_2^.timeStepCount) = F0p0)) then
  begin
    Exit;
  end;
  totalRoutingTime := (timeStepStats_2^.steadyStateTime + timeStepStats_2^.routingTime);
  if (totalRoutingTime > F0p0) then
  begin
    fSteadyState := ((F100p0 * timeStepStats_2^.steadyStateTime) / totalRoutingTime);
  end;
  report_writeLine(PAnsiChar(''));
  report_writeLine(PAnsiChar('*************************'));
  report_writeLine(PAnsiChar('Routing Time Step Summary'));
  report_writeLine(PAnsiChar('*************************'));
  c_fprintf(Frpt.file_, PAnsiChar(#10'  Minimum Time Step           :  %7.2f sec'), [timeStepStats_2^.minTimeStep]);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  Average Time Step           :  %7.2f sec'), [(timeStepStats_2^.routingTime / timeStepCount)]);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  Maximum Time Step           :  %7.2f sec'), [timeStepStats_2^.maxTimeStep]);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  %% of Time in Steady State   :  %7.2f'), [(TernD((fSteadyState <= F100p0), fSteadyState, F100p0))]);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  Average Iterations per Step :  %7.2f'), [(timeStepStats_2^.trialsCount / timeStepCount)]);
  c_fprintf(Frpt.file_, PAnsiChar(#10'  %% of Steps Not Converging   :  %7.2f'), [((F100p0 * I2FD(NonConvergeCount)) / timeStepCount)]);
  if ((RouteModel = 4) and (CourantFactor > F0p0)) then
  begin
    report_RouteStepFreq(timeStepStats_2);
  end;
  report_writeLine(PAnsiChar(''));
end;

{ report.c:1085 }
procedure report_RouteStepFreq(timeStepStats_2: PTTimeStepStats);
var
  totalSteps: Double;
  i: Int32;
begin
  totalSteps := F0p0;
  i := 0;
  totalSteps := F0p0;
  i := 1;
  while (i < 6) do
  begin
    totalSteps := (totalSteps + I2FD(timeStepStats_2^.timeStepCounts[i]));
    Inc(i);
  end;
  if (totalSteps = F0p0) then
  begin
    Exit;
  end;
  c_fprintf(Frpt.file_, PAnsiChar(#10'  Time Step Frequencies       :'), []);
  i := 1;
  while (i < 6) do
  begin
    c_fprintf(Frpt.file_, PAnsiChar(#10'     %6.3f - %6.3f sec      :  %7.2f %%'), [timeStepStats_2^.timeStepIntervals[Int32(i - 1)], timeStepStats_2^.timeStepIntervals[i], ((F100p0 * I2FD(timeStepStats_2^.timeStepCounts[i])) / totalSteps)]);
    Inc(i);
  end;
end;

{ report.c:1113 }
procedure report_writeReport();
begin
  if (ErrorCode <> 0) then
  begin
    Exit;
  end;
  if (Nperiods = 0) then
  begin
    Exit;
  end;
  if ((Int32(ShortInt(RptFlags.subcatchments)) <> 0) and (((IgnoreRainfall = 0) or (IgnoreSnowmelt = 0)) or (IgnoreGwater = 0))) then
  begin
    report_Subcatchments();
  end;
  if ((IgnoreRouting = 1) and (IgnoreQuality = 1)) then
  begin
    Exit;
  end;
  if (Int32(ShortInt(RptFlags.nodes)) <> 0) then
  begin
    report_Nodes();
  end;
  if (Int32(ShortInt(RptFlags.links)) <> 0) then
  begin
    report_Links();
  end;
end;

