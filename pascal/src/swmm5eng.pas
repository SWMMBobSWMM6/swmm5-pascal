{ routing.c:435 }
procedure addExternalInflows(currentDate_2: Double);
label cont1;
var
  j_2: Int32;
  p: Int32;
  q_2: Double;
  w_2: Double;
  inflow: PTExtInflow;
begin
  j_2 := 0;
  p := 0;
  q_2 := F0p0;
  w_2 := F0p0;
  inflow := nil;
  j_2 := 0;
  while (j_2 < Nobjects[2]) do
  begin
    q_2 := Node[j_2].apiExtInflow;
    inflow := Node[j_2].extInflow;
    while (inflow <> nil) do
    begin
      if (inflow^.type_ = 5) then
      begin
        q_2 := (q_2 + inflow_getExtInflow(inflow, currentDate_2));
        Break;
      end
      else
      begin
        inflow := inflow^.next;
      end;
    end;
    if (c_fabs(q_2) < F1em05) then
    begin
      q_2 := F0p0;
    end;
    Node[j_2].newLatFlow := (Node[j_2].newLatFlow + q_2);
    if (q_2 >= F0p0) then
    begin
      massbal_addInflowFlow(0, q_2);
    end
    else
    begin
      massbal_addOutflowFlow((-q_2), 0);
      goto cont1;
    end;
    if ((Node[j_2].type_ = 1) and (Node[j_2].oldNetInflow < F0p0)) then
    begin
      q_2 := (q_2 - Node[j_2].oldNetInflow);
    end;
    inflow := Node[j_2].extInflow;
    while (inflow <> nil) do
    begin
      if (inflow^.type_ <> 5) then
      begin
        p := inflow^.param;
        w_2 := inflow_getExtInflow(inflow, currentDate_2);
        if (inflow^.type_ = 6) then
        begin
          w_2 := (w_2 * q_2);
        end;
        Node[j_2].newQual[p] := (Node[j_2].newQual[p] + w_2);
        massbal_addInflowQual(0, p, w_2);
      end;
      inflow := inflow^.next;
    end;
    cont1:
    Inc(j_2);
  end;
end;

{ routing.c:498 }
procedure addDryWeatherInflows(currentDate_2: Double);
label cont1;
var
  j_2: Int32;
  p: Int32;
  month: Int32;
  day: Int32;
  hour: Int32;
  q_2: Double;
  w_2: Double;
  inflow: PTDwfInflow;
begin
  j_2 := 0;
  p := 0;
  month := 0;
  day := 0;
  hour := 0;
  q_2 := F0p0;
  w_2 := F0p0;
  inflow := nil;
  month := Int32((datetime_monthOfYear(currentDate_2)) - 1);
  day := Int32((datetime_dayOfWeek(currentDate_2)) - 1);
  hour := datetime_hourOfDay(currentDate_2);
  j_2 := 0;
  while (j_2 < Nobjects[2]) do
  begin
    inflow := Node[j_2].dwfInflow;
    if (not (inflow <> nil)) then
    begin
      goto cont1;
    end;
    q_2 := F0p0;
    while (inflow <> nil) do
    begin
      if (inflow^.param < 0) then
      begin
        q_2 := inflow_getDwfInflow(inflow, month, day, hour);
        Break;
      end;
      inflow := inflow^.next;
    end;
    if (c_fabs(q_2) < F1em05) then
    begin
      q_2 := F0p0;
    end;
    Node[j_2].newLatFlow := (Node[j_2].newLatFlow + q_2);
    massbal_addInflowFlow(1, q_2);
    if (q_2 <= F0p0) then
    begin
      goto cont1;
    end;
    p := 0;
    while (p < Nobjects[4]) do
    begin
      if (Pollut[p].dwfConcen > F0p0) then
      begin
        w_2 := (q_2 * Pollut[p].dwfConcen);
        Node[j_2].newQual[p] := (Node[j_2].newQual[p] + w_2);
        massbal_addInflowQual(1, p, w_2);
      end;
      Inc(p);
    end;
    inflow := Node[j_2].dwfInflow;
    while (inflow <> nil) do
    begin
      if (inflow^.param >= 0) then
      begin
        p := inflow^.param;
        w_2 := (q_2 * inflow_getDwfInflow(inflow, month, day, hour));
        Node[j_2].newQual[p] := (Node[j_2].newQual[p] + w_2);
        massbal_addInflowQual(1, p, w_2);
        if (Pollut[p].dwfConcen > F0p0) then
        begin
          w_2 := (q_2 * Pollut[p].dwfConcen);
          Node[j_2].newQual[p] := (Node[j_2].newQual[p] - w_2);
          massbal_addInflowQual(1, p, (-w_2));
        end;
      end;
      inflow := inflow^.next;
    end;
    cont1:
    Inc(j_2);
  end;
end;

