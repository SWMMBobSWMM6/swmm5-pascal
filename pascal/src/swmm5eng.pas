{ lid.c:932 }
procedure validateLidProc(j_2: Int32);
label swend1, swend2;
var
  layerMissing: Int32;
begin
  layerMissing := 0;
  layerMissing := 0;
  if (LidProcs[j_2].lidType < 0) then
  begin
    report_writeErrorMsg(183, LidProcs[j_2].ID);
    Exit;
  end;
  case LidProcs[j_2].lidType of
    BIO_CELL, RAIN_GARDEN:
    begin
      if (LidProcs[j_2].soil.thickness <= F0p0) then
      begin
        layerMissing := 1;
      end;
      goto swend1;
    end;
    GREEN_ROOF:
    begin
      if (LidProcs[j_2].soil.thickness <= F0p0) then
      begin
        layerMissing := 1;
      end;
      if (LidProcs[j_2].drainMat.thickness <= F0p0) then
      begin
        layerMissing := 1;
      end;
      goto swend1;
    end;
    POROUS_PAVEMENT:
    begin
      if (LidProcs[j_2].pavement.thickness <= F0p0) then
      begin
        layerMissing := 1;
      end;
      goto swend1;
    end;
    INFIL_TRENCH:
    begin
      if (LidProcs[j_2].storage.thickness <= F0p0) then
      begin
        layerMissing := 1;
      end;
      goto swend1;
    end;
  end;
  swend1: ;
  if (layerMissing <> 0) then
  begin
    report_writeErrorMsg(184, LidProcs[j_2].ID);
    Exit;
  end;
  if (LidProcs[j_2].lidType = 4) then
  begin
    if (((((LidProcs[j_2].pavement.thickness <= F0p0) or (LidProcs[j_2].pavement.kSat <= F0p0)) or (LidProcs[j_2].pavement.voidFrac <= F0p0)) or (LidProcs[j_2].pavement.voidFrac > F1p0)) or (LidProcs[j_2].pavement.impervFrac > F1p0)) then
    begin
      sstrncpy(@Msg[0], LidProcs[j_2].ID, 1024);
      sstrcat(@Msg[0], PAnsiChar(' - check pavement layer parameters'), 1024);
      report_writeErrorMsg(185, @Msg[0]);
    end;
  end;
  if (LidProcs[j_2].soil.thickness > F0p0) then
  begin
    if (((((LidProcs[j_2].soil.porosity <= F0p0) or (LidProcs[j_2].soil.fieldCap >= LidProcs[j_2].soil.porosity)) or (LidProcs[j_2].soil.wiltPoint >= LidProcs[j_2].soil.fieldCap)) or (LidProcs[j_2].soil.kSat <= F0p0)) or (LidProcs[j_2].soil.kSlope < F0p0)) then
    begin
      sstrncpy(@Msg[0], LidProcs[j_2].ID, 1024);
      sstrcat(@Msg[0], PAnsiChar(' - check soil layer parameters'), 1024);
      report_writeErrorMsg(185, @Msg[0]);
    end;
  end;
  if (LidProcs[j_2].storage.thickness > F0p0) then
  begin
    if ((LidProcs[j_2].storage.voidFrac <= F0p0) or (LidProcs[j_2].storage.voidFrac > F1p0)) then
    begin
      sstrncpy(@Msg[0], LidProcs[j_2].ID, 1024);
      sstrcat(@Msg[0], PAnsiChar(' - check storage layer parameters'), 1024);
      report_writeErrorMsg(185, @Msg[0]);
    end;
  end
  else
  begin
    LidProcs[j_2].storage.voidFrac := F1p0;
    LidProcs[j_2].drain.offset := F0p0;
  end;
  if ((LidProcs[j_2].drain.hOpen > F0p0) and (LidProcs[j_2].drain.hOpen <= LidProcs[j_2].drain.hClose)) then
  begin
    sstrncpy(@Msg[0], LidProcs[j_2].ID, 1024);
    sstrcat(@Msg[0], PAnsiChar(' - invalid drain open/closed heads'), 1024);
    report_writeErrorMsg(185, @Msg[0]);
  end;
  if (LidProcs[j_2].lidType = 6) then
  begin
    if (((LidProcs[j_2].surface.roughness * LidProcs[j_2].surface.surfSlope) <= F0p0) or (LidProcs[j_2].surface.thickness = F0p0)) then
    begin
      sstrncpy(@Msg[0], LidProcs[j_2].ID, 1024);
      sstrcat(@Msg[0], PAnsiChar(' - check swale surface parameters'), 1024);
      report_writeErrorMsg(185, @Msg[0]);
    end
    else
    begin
      LidProcs[j_2].surface.alpha := ((F1p49 * c_sqrt(LidProcs[j_2].surface.surfSlope)) / LidProcs[j_2].surface.roughness);
    end;
  end
  else
  begin
    if (LidProcs[j_2].surface.roughness > F0p0) then
    begin
      LidProcs[j_2].surface.alpha := ((F1p49 / LidProcs[j_2].surface.roughness) * c_sqrt(LidProcs[j_2].surface.surfSlope));
    end
    else
    begin
      LidProcs[j_2].surface.alpha := F0p0;
    end;
  end;
  if (LidProcs[j_2].drainMat.roughness > F0p0) then
  begin
    LidProcs[j_2].drainMat.alpha := ((F1p49 / LidProcs[j_2].drainMat.roughness) * c_sqrt(LidProcs[j_2].surface.surfSlope));
  end
  else
  begin
    LidProcs[j_2].drainMat.alpha := F0p0;
  end;
