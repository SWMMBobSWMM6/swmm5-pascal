{ routing.c:776 }
function inflowHasChanged(): Int32;
var
  j_2: Int32;
  diff: Double;
  qOld: Double;
  qNew: Double;
begin
  j_2 := 0;
  diff := F0p0;
  qOld := F0p0;
  qNew := F0p0;
  j_2 := 0;
  while (j_2 < Nobjects[2]) do
  begin
    qOld := Node[j_2].oldLatFlow;
    qNew := Node[j_2].newLatFlow;
    if (c_fabs(qOld) > F1em06) then
    begin
      diff := ((qNew / qOld) - F1p0);
    end
    else if (c_fabs(qNew) > F1em06) then
    begin
      diff := F1p0;
    end
    else
    begin
      diff := F0p0;
    end;
    if (c_fabs(diff) > LatFlowTol) then
    begin
      Exit(1);
    end;
    if ((Node[j_2].type_ = 1) or (Node[j_2].degree = 0)) then
    begin
      qOld := Node[j_2].oldFlowInflow;
      qNew := Node[j_2].inflow;
      if (c_fabs(qOld) > F1em06) then
      begin
        diff := ((qNew / qOld) - F1p0);
      end
      else if (c_fabs(qNew) > F1em06) then
      begin
        diff := F1p0;
      end
      else
      begin
        diff := F0p0;
      end;
      if (c_fabs(diff) > LatFlowTol) then
      begin
        Exit(1);
      end;
    end;
    Inc(j_2);
  end;
  Exit(0);
end;

